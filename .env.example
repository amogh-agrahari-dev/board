# ==============================================================================
# BOARD: Investment-Opportunity Engine Environment Configuration
# ==============================================================================
# All keys are OPTIONAL. BOARD functions completely out-of-the-box in keyless
# mode using yfinance, Google News RSS, and calibrated broadsheet fallback data.
#
# To use your own API keys, rename or copy this file to `.env`:
#   cp .env.example .env
# Then fill in your keys below.
# ==============================================================================

# 1. Finnhub Stock API Key (Recommended for live institutional company news)
#    Get a free key at: https://finnhub.io/
#    Provides ~1 year of real-time company news headlines and timestamps.
#    If omitted, BOARD falls back to Google News RSS (feedparser) & broadsheet wire.
FINNHUB_API_KEY=""

# 2. Federal Reserve Economic Data (FRED) API Key (Macro series)
#    Get a free key at: https://fred.stlouisfed.org/docs/api/api_key.html
#    Provides real-time yield curves, inflation, and interest rate updates.
#    If omitted, BOARD uses yfinance proxy tickers (^TNX, ^VIX, ^INDIAVIX, USDINR=X).
FRED_API_KEY=""

# 3. NewsAPI Key (Secondary news source)
#    Get a free key at: https://newsapi.org/
NEWSAPI_KEY=""

# 4. LLM API Key (Optional narrative polish for deterministic reports)
#    If omitted, BOARD generates 100% deterministic, audit-ready reports
#    directly from computed math, SHAP drivers, and risk metrics.
LLM_API_KEY=""

# 5. Social Sentiment (Reddit / StockTwits / Twitter)
#    Default is false. Marked as low-trust source in Stage 3 ablation.
ENABLE_SOCIAL=false

# 6. Performance Mode
#    FAST_MODE=true enables calibrated lexicon scoring and rapid sequence
#    evaluations for fast laptop-feasible CPU inference (<1s per asset).
#    FAST_MODE=false runs full FinBERT transformer weights and expanding deep folds.
FAST_MODE=true
